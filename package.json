{
	"name": "fortuna",
	"version": "0.65.4",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"bun": ">=1.4"
	},
	"scripts": {
		"db:seed:preview": "bun scripts/seed-preview.ts",
		"db:bootstrap:local": "bun scripts/bootstrap-local.ts",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "bun --smol .output/server/index.mjs",
		"generate-routes": "tsr generate",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"smoke": "bun scripts/smoke-routes.ts",
		"screenshots": "bun scripts/capture-screenshots.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"verify": "bun run check && bun run typecheck && bun run test && bun run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/server/db/migrate.ts",
		"db:seed": "bun scripts/seed.ts",
		"db:reset": "bun scripts/reset-db.ts",
		"icons": "bun scripts/copy-brand-assets.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/spectral": "^5.3.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@openai/codex": "0.164.0",
		"@orpc/client": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"@orpc/tanstack-query": "^1.16.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.4",
		"@valibot/to-json-schema": "^1.8.0",
		"better-auth": "^1.7.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.61.0",
		"next-themes": "^0.4.6",
		"nitro": "npm:nitro-nightly@3.0.1-20261023-052727-7e9a0481",
		"pg": "^8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@tanstack/router-cli": "^1.167.46",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"playwright": "^1.64.1",
		"railway": "^3.16.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"esbuild": "0.28.2"
	}
}
