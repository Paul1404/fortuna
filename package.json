{
	"name": "fortuna",
	"version": "0.62.1",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"bun": ">=1.4"
	},
	"scripts": {
		"db:bootstrap:local": "bun scripts/bootstrap-local.ts",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "bun .output/server/index.mjs",
		"generate-routes": "tsr generate",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"smoke": "bun scripts/smoke-routes.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"verify": "bun run check && bun run typecheck && bun run test && bun run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/server/db/migrate.ts",
		"db:seed": "bun scripts/seed.ts",
		"db:reset": "bun scripts/reset-db.ts",
		"icons": "bun scripts/copy-brand-assets.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/spectral": "^5.3.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@openai/codex": "0.154.0",
		"@orpc/client": "^1.15.0",
		"@orpc/server": "^1.15.0",
		"@orpc/tanstack-query": "^1.15.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.36",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.54",
		"@valibot/to-json-schema": "^1.7.1",
		"better-auth": "^1.7.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.46.0",
		"next-themes": "^0.4.6",
		"nitro": "npm:nitro-nightly@3.0.1-20260914-082759-0b1741a1",
		"pg": "^8.23.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"valibot": "^1.4.2"
