		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.63.0",
		"railway": "^3.11.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
