      "warning-bg": "#241D10",
      "info": "#7FB2FF",
      "info-bg": "#0E1C44",
      "focus": "#6C9BFF"
    },
    "chart": {
      "series": [
        "#0018A8",
        "#0A50D0",
        "#4C8DFF",
        "#0B7A8C",
        "#9CC0FF",
        "#5B6B8C",
        "#9AA8C4"
      ],
      "seriesDark": [
        "#6C9BFF",
