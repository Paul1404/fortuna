        "#C1CADC",
        "#97A2B8"
      ]
    },
    "navy": {
      "nav": "#08112E",
      "nav-raised": "#0F1B46",
      "nav-border": "#1E2F68",
      "nav-text": "#C2D3F4",
      "nav-muted": "#8398C9",
      "nav-active": "#FFFFFF",
      "hero-from": "#04091F",
      "hero-via": "#0A1742",
      "hero-to": "#10328A",
      "hero-text": "#FFFFFF",
      "hero-muted": "#A3B8EC",
      "hero-border": "#24397E",
      "glow": "#4C8DFF",
      "glow-soft": "#0B3FD0"
    }
  },
  "typography": {
    "families": {
      "display": "Spectral",
      "sans": "Instrument Sans",
      "mono": "IBM Plex Mono"
    },
    "numeric": {
      "fontVariantNumeric": "tabular-nums lining-nums",
      "displayLetterSpacing": "-0.015em"
    },
    "scale": {
      "display": {
        "font": "Spectral",
        "weight": 300,
        "size": 44,
        "lineHeight": 1.1,
        "letterSpacing": "-0.015em"
      },
      "title": {
        "font": "Spectral",
        "weight": 400,
        "size": 30,
        "lineHeight": 1.2,
        "letterSpacing": "-0.01em"
      },
      "h1": {
        "font": "Instrument Sans",
        "weight": 600,
        "size": 20,
        "lineHeight": 1.3
      },
      "h2": {
        "font": "Instrument Sans",
        "weight": 600,
        "size": 15,
        "lineHeight": 1.4
      },
      "body": {
        "font": "Instrument Sans",
        "weight": 400,
        "size": 14,
        "lineHeight": 1.7
      },
      "caption": {
        "font": "Instrument Sans",
        "weight": 400,
        "size": 12,
        "lineHeight": 1.5
      },
      "label": {
        "font": "Instrument Sans",
        "weight": 500,
        "size": 11,
        "letterSpacing": "0.13em",
        "textTransform": "uppercase"
      },
      "mono": {
        "font": "IBM Plex Mono",
        "weight": 400,
        "size": 12
      },
      "amountDisplay": {
        "font": "Instrument Sans",
        "weight": 600,
        "size": 56,
        "letterSpacing": "-0.02em"
      },
      "amountLarge": {
        "font": "Instrument Sans",
        "weight": 600,
        "size": 23,
        "letterSpacing": "-0.015em"
      },
      "amountSmall": {
        "font": "Instrument Sans",
        "weight": 600,
        "size": 13.5
      }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 8,
    "icon": "22.6%"
  },
  "border": {
    "width": 1
  },
  "logo": {
    "grid": 66,
    "strokeWidth": 10,
    "faviconStrokeWidth": 11,
    "clearSpace": "1.5 × stroke",
    "minSize": 16
  }
}
