# PostgreSQL connection string. Railway's Postgres plugin injects this.
DATABASE_URL=postgres://fortuna:fortuna@localhost:5432/fortuna
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000

# better-auth: at least 32 random bytes, e.g. `openssl rand -hex 32`.
# Also derives the key that encrypts stored bank-provider secrets.
BETTER_AUTH_SECRET=
# Public base URL of the deployment (cookies, redirects, trusted origins).
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra origins allowed to call the auth endpoints.
AUTH_TRUSTED_ORIGINS=

# Owner account. Created by `bun run db:migrate` when it does not exist yet.
# Sign-up is disabled; this is the only way an account comes into existence.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Read-only MCP endpoint at /api/mcp. Leave empty to keep it disabled.
# At least 32 random bytes, e.g. `openssl rand -hex 32`.
MCP_BEARER_TOKEN=

# Optional private S3-compatible storage for encrypted contract documents.
# Without all five values Fortuna uses the encrypted PostgreSQL fallback.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Log level: debug | info | warn | error (default info in production).
LOG_LEVEL=info
